// Test-only policies for cloud-storage-emulator-cdp.mjs. Never deploy these rules.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pfm_users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /snapshots/{snapshotId} {
        allow read, write: if request.auth != null && request.auth.uid == uid && uid == 'chunk-test';
      }
    }
  }
}

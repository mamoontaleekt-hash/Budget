// Optional owner-only snapshot access when a compressed account outgrows one document.
// Review alongside the project's existing rules before applying in Firebase Console.
// Normal inline compressed saves use the existing pfm_users/{uid} document permission.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pfm_users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /snapshots/{snapshotId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
